# Copy to .env.local for local development, or set these in Vercel.
# Everything VITE_-prefixed is inlined into the bundle and therefore public --
# never put a service-role key or OAuth client secret here.

# Changing any of these in Vercel has no effect until the project is REDEPLOYED,
# because the values are frozen into the bundle by the build that produced it.

# Backend (Render) base URL. Omit locally to use http://localhost:8000
VITE_API_URL=https://automated-email-ai.onrender.com

# Supabase project. Both are required: nothing is compiled into the client as a
# fallback, so a build without them cannot sign anyone in. The anon key is the
# publishable one under Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
