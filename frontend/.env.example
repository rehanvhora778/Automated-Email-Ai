# Copy to .env.local for local development, or set these in Vercel.
# Everything VITE_-prefixed is inlined into the bundle and therefore public --
# never put a service-role key or OAuth client secret here.

# Backend (Render) base URL. Omit locally to use http://localhost:8000
VITE_API_URL=https://your-service.onrender.com

# Supabase project. Omit to use the defaults baked into supabaseClient.ts
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
