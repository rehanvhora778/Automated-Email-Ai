# Copy to .env for local development. On Render, set these under
# Environment -> Environment Variables. Never commit the real .env.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key      # service_role, NOT the anon key

# --- Mistral AI ---
MISTRAL_API_KEY=your-mistral-key

# --- Google OAuth (production) ---
# Locally the app reads backend/credentials.json instead. On Render that file
# does not exist, so paste its entire contents as a single line here.
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}

# Must match an Authorized redirect URI on the Google OAuth client.
OAUTH_REDIRECT_URI=https://your-service.onrender.com/api/v1/actions/callback

# --- Email (verification codes) ---
# Signup and password-reset codes are sent by this backend, not by Supabase.
# Pick ONE transport; the first credential found wins.
#
# Most hosts (Render's free tier included) block outbound SMTP ports, so an
# HTTP provider is the reliable choice in production. SMTP is fine locally.

# Option A - Brevo (recommended: 300/day free, mails any address once you
# verify one sender). Key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
MAIL_FROM=you@gmail.com          # must be a Brevo-verified sender
MAIL_FROM_NAME=Smart Email Agent

# Option B - Resend. Key from https://resend.com/api-keys
# On the shared onboarding@resend.dev sender you can only mail your own
# account address; verify a domain to reach anyone else.
# RESEND_API_KEY=re_...
# MAIL_FROM=onboarding@resend.dev

# Option C - SMTP, for local development or a host that allows it.
# Gmail needs an App Password (https://myaccount.google.com/apppasswords),
# not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com

# Force a transport when more than one credential is present.
# EMAIL_PROVIDER=brevo
# Optional. Salt for the stored code hashes; defaults to SUPABASE_KEY.
# OTP_PEPPER=any-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional regex to also allow Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
