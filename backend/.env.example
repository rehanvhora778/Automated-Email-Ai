# Copy to .env for local development. On Render, set these under
# Environment -> Environment Variables. Never commit the real .env.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key      # service_role, NOT the anon key

# --- Mistral AI ---
MISTRAL_API_KEY=your-mistral-key

# --- Google OAuth (production) ---
# Locally the app reads backend/credentials.json instead. On Render that file
# does not exist, so paste its entire contents as a single line here.
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}

# Must match an Authorized redirect URI on the Google OAuth client.
OAUTH_REDIRECT_URI=https://your-service.onrender.com/api/v1/actions/callback

# --- Email (verification codes) ---
# Signup and password-reset codes are sent by this backend, not by Supabase,
# whose templates mail a link unless edited and whose code length is a project
# setting. Any SMTP provider works.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it below (not the account
# password, which Google rejects for SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Smart Email Agent
# Optional. STARTTLS is on by default; set false only for a local relay.
# SMTP_STARTTLS=true
# Optional. Salt for the stored code hashes; defaults to SUPABASE_KEY.
# OTP_PEPPER=any-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional regex to also allow Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
