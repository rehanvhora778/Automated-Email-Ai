# Copy to .env for local development. On Render, set these under
# Environment -> Environment Variables. Never commit the real .env.
#
# The URLs below are the deployed ones, so a local copy should drop
# OAUTH_REDIRECT_URI, FRONTEND_URL and ALLOWED_ORIGINS rather than keep them:
# unset, they already resolve to localhost:8000 and the Vite dev servers, while
# the production values send the OAuth round trip to Render and leave the dev
# frontend blocked by CORS.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key      # service_role, NOT the anon key

# --- Mistral AI ---
MISTRAL_API_KEY=your-mistral-key

# --- Google OAuth (production) ---
# Locally the app reads backend/credentials.json instead. On Render that file
# does not exist, so paste its entire contents as a single line here.
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}

# Must match an Authorized redirect URI on the Google OAuth client, character
# for character. On Render this can be omitted, in which case it is derived
# from RENDER_EXTERNAL_URL, which Render injects for you.
OAUTH_REDIRECT_URI=https://automated-email-ai.onrender.com/api/v1/actions/callback

# Where the browser is sent once Google hands the code back. Without it the
# user is stranded on a bare response served from the API domain.
FRONTEND_URL=https://automated-email-ai.vercel.app

# --- Email (verification codes) ---
# Signup and password-reset codes are sent by this backend, not by Supabase.
# Pick ONE transport; with several configured the order is Resend, Brevo,
# Gmail API, then SMTP.
#
# Most hosts (Render's free tier included) block outbound SMTP ports, so an
# HTTP provider is the reliable choice in production. SMTP is fine locally.

# Option A - Brevo (recommended: 300/day free, mails any address once you
# verify one sender). Key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
MAIL_FROM=you@gmail.com          # must be a Brevo-verified sender
MAIL_FROM_NAME=Smart Email Agent

# Option B - Resend. Key from https://resend.com/api-keys
# On the shared onboarding@resend.dev sender you can only mail your own
# account address; verify a domain to reach anyone else.
# RESEND_API_KEY=re_...
# MAIL_FROM=onboarding@resend.dev

# Option C - a linked Gmail account. Available ONLY if you name the profile
# it sends from; there is no automatic choice. Borrowing whichever mailbox
# happened to be linked first would drop strangers' verification codes into
# that person's Sent folder, so an operator has to opt in by id. Used when
# neither HTTP key above is set.
# MAIL_GMAIL_PROFILE_ID=00000000-0000-0000-0000-000000000000

# Option D - SMTP, for local development or a host that allows it.
# Gmail needs an App Password (https://myaccount.google.com/apppasswords),
# not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=Smart Email Agent
# Port 465 is taken to mean implicit SSL and no STARTTLS; these two only exist
# for a server that disagrees with that reading of its own port.
# SMTP_USE_SSL=false
# SMTP_STARTTLS=true

# Force a transport when more than one credential is present.
# One of: resend, brevo, gmail_api, smtp
# EMAIL_PROVIDER=brevo
# Optional. Salt for the stored code hashes; defaults to SUPABASE_KEY.
# OTP_PEPPER=any-long-random-string

# --- CORS ---
# Comma-separated list of allowed frontend origins. No trailing slashes.
ALLOWED_ORIGINS=https://automated-email-ai.vercel.app
# Optional regex to also allow Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Model files (optional) ---
# The spam and phishing classifiers resolve to ml/models/ relative to the repo
# root. Only set these if the .joblib files live somewhere else.
# SPAM_MODEL_PATH=../ml/models/spam_clf.joblib
# PHISHING_MODEL_PATH=../ml/models/phishing_clf.joblib
